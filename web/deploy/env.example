# Copy to /etc/himalayanleaf/env — root-owned, chmod 640, chgrp to the service user.
# systemd reads this file directly; no python-dotenv involved.
#
# Generate the key with:
#   python3 -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=dev.himalayanleaf.co
DJANGO_CSRF_TRUSTED_ORIGINS=https://dev.himalayanleaf.co

# Writable state lives outside the checkout so a deploy never touches it.
DJANGO_DB_PATH=/var/lib/himalayanleaf/db.sqlite3
DJANGO_MEDIA_ROOT=/var/lib/himalayanleaf/media

# Postgres instead of SQLite — setting DJANGO_DB_NAME is what switches it.
# Needs `pip install psycopg[binary]` in the venv.
# DJANGO_DB_NAME=himalayanleaf
# DJANGO_DB_USER=himalayanleaf
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost

# HSTS stays off on a subdomain by default — see the note in config/settings.py.
# DJANGO_HSTS_SECONDS=31536000

# GUNICORN_WORKERS=3
